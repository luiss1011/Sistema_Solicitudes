<%- include('../partials/header') %>

<%- include('../partials/navbar', { user }) %>

<div class="d-flex">

  <%- include('../partials/sidebar') %>

  <div class="container-fluid p-4">

    <h2 class="mb-4">
      Nueva Solicitud
    </h2>

    <div class="card p-4 shadow-sm">

<% if (errors && errors.length > 0) { %>

  <div class="alert alert-danger">

    <ul class="mb-0">

      <% errors.forEach(error => { %>

        <li>
          <%= error.msg %>
        </li>

      <% }) %>

    </ul>

  </div>

<% } %>

      <form action="/solicitudes" method="POST">

        <div class="mb-3">

          <label class="form-label">
            Título
          </label>

          <input
            type="text"
            name="titulo"
            class="form-control"
            value="<%= old?.titulo || '' %>"
          >

        </div>

        <div class="mb-3">

          <label class="form-label">
            Descripción
          </label>

          <textarea
  name="descripcion"
  class="form-control"
  rows="4"
><%= old?.descripcion || '' %></textarea>

        </div>

        <div class="mb-3">

          <label class="form-label">
            Departamento
          </label>

          <select
  name="departamento"
  class="form-select"
>

            <option value="">
              Selecciona
            </option>

            <option value="RH"
  <%= old?.departamento === 'RH' ? 'selected' : '' %>>
              RH
            </option>

            <option value="Sistemas" <%= old?.departamento === 'Sistemas' ? 'selected' : '' %>>
              Sistemas
            </option>

            <option value="Servicios Generales" <%= old?.departamento === 'Servicios Generales' ? 'selected' : '' %>>
              Servicios Generales
            </option>

          </select>

        </div>

        <div class="mb-3">

          <label class="form-label">
            Categoría
          </label>

          <input
  type="text"
  name="categoria"
  class="form-control"
  value="<%= old?.categoria || '' %>"
>

        </div>

        <button class="btn btn-dark">
          Crear Solicitud
        </button>

      </form>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>